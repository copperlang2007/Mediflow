{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "evidence": "playwright test --config=runner/playwright.evidence.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "seed:demo": "pnpm --filter @workspace/scripts run seed:demo"
  },
  "private": true,
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/supertest": "^7.2.0",
    "@vitest/ui": "^4.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/core@>=2.0.0 <2.8.0": "^2.8.0",
      "axios@>=1.0.0 <1.18.0": "^1.18.0",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "browserslist@<=4.28.6": "^4.28.7",
      "esbuild@<=0.24.2": "^0.25.0",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "fflate@>=0.8.0 <0.8.3": "^0.8.3",
      "form-data@>=2.0.0 <2.5.6": "^2.5.6",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "http-proxy-middleware@>=3.0.0 <3.0.7": "^3.0.7",
      "ip-address@<=10.3.0": "^10.3.1",
      "js-cookie@<3.0.7": "^3.0.7",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "linkify-it@>=5.0.0 <5.0.2": "^5.0.2",
      "markdown-it@>=14.0.0 <14.2.0": "^14.2.0",
      "multer@>=2.0.0 <2.2.0": "^2.2.0",
      "nanoid@>=3.0.0 <3.3.17": "^3.3.17",
      "nanoid@>=4.0.0 <5.1.16": "^5.1.16",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "qs@<6.16.0": "^6.16.0",
      "uuid@<11.1.1": "^11.1.1",
      "vite@>=7.0.0 <7.3.5": "^7.3.5",
      "ws@>=8.0.0 <8.20.1": "^8.20.1"
    }
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  }
}
